<odoo>
    <record id="res_config_settings_view_form_inherit" model="ir.ui.view">
        <field name="name">inherit.currency.rate.form.inherit.bccr</field>
        <field name="model">res.config.settings</field>
        <field name="active">True</field>
        <field name="inherit_id" ref="currency_rate_live.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='update_exchange_rates']" position="after">
                <setting id="BCCR_setting" string="Banco Central de Costa Rica">

                    <label for="token_bccr" class="col-lg-4 o_light_label" string="BCCR Token"/>
                    <field name="token_bccr"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>